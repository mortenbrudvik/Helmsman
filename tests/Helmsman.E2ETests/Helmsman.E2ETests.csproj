<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests: the real server services against the suite's own fixture app (tests/FixtureApp).
    Every test that starts the fixture is gated ([DesktopNoInputFact] or [DesktopFact]) and skipped unless
    its opt-in variable is set; the harness checks the gate again before it starts anything.
    HarnessTests/ holds ordinary tests of the harness itself, which never start the fixture.
    See TESTING.md, "End-to-end tests against the fixture app".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Helmsman.E2ETests</RootNamespace>
    <AssemblyName>Helmsman.E2ETests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Helmsman\Helmsman.csproj" />
    <ProjectReference Include="..\Helmsman.Tests.Infrastructure\Helmsman.Tests.Infrastructure.csproj" />
    <!--
      Built before this project but not referenced: the harness starts HelmsmanFixtureApp.exe from the fixture's
      own output folder (see HelmsmanFixtureAppPath below), so the fixture is never loaded into the test host
      and never instrumented for coverage.
    -->
    <ProjectReference Include="..\FixtureApp\FixtureApp.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- One contract for both sides: titles, AutomationIds, event names, the command line and the save folder's rule -->
    <Compile Include="..\FixtureApp\FixtureContract.cs" Link="FixtureContract\FixtureContract.cs" />
    <Compile Include="..\FixtureApp\FixtureOptions.cs" Link="FixtureContract\FixtureOptions.cs" />
    <Compile Include="..\FixtureApp\FixtureSaveFolder.cs" Link="FixtureContract\FixtureSaveFolder.cs" />
    <!-- What the GL frame counter window draws, so the tests decode its captures with the layout it was drawn with -->
    <Compile Include="..\FixtureApp\GlFrameCounterLayout.cs" Link="FixtureContract\GlFrameCounterLayout.cs" />
    <!-- The GL window's watchdog, so its deadline and decision are tested without starting the fixture -->
    <Compile Include="..\FixtureApp\GlWindowWatchdog.cs" Link="FixtureContract\GlWindowWatchdog.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation reads (System.Windows.Automation), as the server uses -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <!--
    Records where the fixture exe is, relative to this project's output folder, as
    [assembly: AssemblyMetadata("HelmsmanFixtureAppPath", "...")]. FixtureAppLocator reads it, so the tests
    start exactly the fixture built with the same configuration.
  -->
  <Target Name="AddHelmsmanFixtureAppPathMetadata" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\FixtureApp\FixtureApp.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_HelmsmanFixtureAppTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_HelmsmanFixtureAppExe>@(_HelmsmanFixtureAppTargetPath->'%(RootDir)%(Directory)%(Filename).exe')</_HelmsmanFixtureAppExe>
      <_HelmsmanFixtureAppRelativeExe>$([MSBuild]::MakeRelative('$(TargetDir)', '$(_HelmsmanFixtureAppExe)'))</_HelmsmanFixtureAppRelativeExe>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>HelmsmanFixtureAppPath</_Parameter1>
        <_Parameter2>$(_HelmsmanFixtureAppRelativeExe)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
