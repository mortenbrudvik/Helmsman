<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HelmsmanFixtureApp: a small WPF app with known AutomationIds that the end-to-end tests
    (tests/Helmsman.E2ETests) start, read, capture and type into. The suite owns this
    app, so its desktop tests never act on the developer's own windows.

    Never start it from a normal test run: only the E2E harness starts it, and only when a desktop
    tier is opted in (see TESTING.md, "End-to-end tests against the fixture app"). FixtureContract.cs,
    FixtureOptions.cs, FixtureSaveFolder.cs, GlFrameCounterLayout.cs and GlWindowWatchdog.cs are also
    compiled into the E2E project, so both sides share one contract.

    The GL frame counter window (open-gl) is plain Win32 and OpenGL 1.1 through P/Invoke to user32,
    gdi32 and opengl32: no package.

    The WebView2 window (roadmap M3.F4) uses the Microsoft.Web.WebView2 package, which every build
    restores and copies, but it starts WebView2, and so needs the Edge WebView2 runtime, only when the
    fixture is started with open-web-view. Its scenario is skipped on a machine without the runtime.

    There is no WebView2 hosted as a visual (roadmap M3.F23): the package's WebView2CompositionControl
    draws the page into a WPF Image and gives UI Automation no element of it (no automation peer), so
    the server cannot read that page. AccessibilityWarmupTests cover the detection instead.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HelmsmanFixtureApp</AssemblyName>
    <RootNamespace>Helmsman.FixtureApp</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Common controls version 6, for the task dialog; no DPI setting (see app.manifest) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
